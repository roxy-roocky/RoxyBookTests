@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity
@using RoxyBookTests.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Authentification à 2 facteurs (2FA)</PageTitle>

<StatusMessage />
<h3>
    L'authentification à 2 facteurs (2FA)
</h3>
@if (canTrack)
{
    if (is2faEnabled)
    {
        if (recoveryCodesLeft == 0)
        {
            <div class="alert alert-danger">
                <strong>Vous n'avez plus de code de récupération disponible.</strong>
                <p>Vous devez <a href="Account/Manage/GenerateRecoveryCodes">générer un nouvel ensemble de codes</a> avant de pouvoir vous connecter avec un code de récupération.</p>
            </div>
        }
        else if (recoveryCodesLeft == 1)
        {
            <div class="alert alert-danger">
                <strong>Il ne vous reste plus qu'un seul code de récupération.</strong>
                <p>Il est recommandé de <a href="Account/Manage/GenerateRecoveryCodes">générer un nouvel ensemble de code de récupération</a>.</p>
            </div>
        }
        else if (recoveryCodesLeft <= 3)
        {
            <div class="alert alert-warning">
                <strong>Il vous reste @recoveryCodesLeft code@(recoveryCodesLeft > 1 ? "s":"") de récupération.</strong>
                <p>Vous pouvez <a href="Account/Manage/GenerateRecoveryCodes">générer un nouvel ensemble de code de récupération ici</a>.</p>
            </div>
        }

        if (isMachineRemembered)
        {
            <form style="display: inline-block" @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-primary">Oublier ce navigateur</button>
            </form>
        }

        <div class="mt-3">
            <a href="Account/Manage/Disable2fa" class="btn btn-danger"><i class="bi bi-trash-fill"></i>&nbsp; Désactiver la 2FA</a>
        </div>
        <div class="mt-3">
            <a href="Account/Manage/GenerateRecoveryCodes" class="btn btn-secondary"><i class="bi bi-arrow-clockwise"></i>&nbsp; Générer des nouveau codes de récupération</a>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
                <strong>La 2FA est désactivée pour ce compte. Vous pouvez la réactiver en enrôlant une application de 2FA.</strong>
        </div>
    }

    @if (!hasAuthenticator)
    {
        <a href="Account/Manage/EnableAuthenticator" class="btn btn-primary">Ajouter une application de 2FA</a>
    }
    else
    {
        <div class="mt-3">
            <a href="Account/Manage/EnableAuthenticator" class="btn btn-secondary"><i class="bi bi-plus-circle-fill"></i>&nbsp; Enrôler une autre application de 2FA</a>
        </div>
        <div class="mt-3">
            <a href="Account/Manage/ResetAuthenticator" class="btn btn-secondary"><i class="bi bi-arrow-clockwise"></i>&nbsp; Réinitisaliser la clé 2FA</a>
        </div>
    }
}
else
{
    <div class="alert alert-danger">
        <strong>Cookie non acceptés.</strong>
        <p>Vous devez autorier les cookies pour utiliser la 2FA.</p>
    </div>
}

@code {
    private bool canTrack;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            "Ce navigateur a été oublié par la 2FA, un code vous sera demandé lors de votre prochaine connexion.",
            HttpContext);
    }
}
