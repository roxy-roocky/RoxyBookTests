<StatusMessage Message="@StatusMessage" />
<h3>Codes de récupération</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <strong>Stockez ces codes dans un endroit sûr.</strong>
    </p>
    <p>
        Si vous perdez accès à votre application de 2FA, vous pouvez utiliser un de ces codes. Chaque code n'est utilisable qu'une seule fois.
    </p>
</div>
<div class="row">
    <div class="col-md-12">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <div>
                <code class="recovery-code">@recoveryCode</code>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
